[Unit]
Description=BondRadar live operations monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/BondRadar
EnvironmentFile=/opt/BondRadar/.env.production
ExecStart=/bin/bash -lc '/usr/bin/python3 scripts/live_operations_runner.py --mode monitoring --json-output ./logs/live_ops_monitoring_$(date -u +%%Y%%m%%dT%%H%%M%%SZ).json'
