[Unit]
Description=BondRadar live paper due dry-run
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/BondRadar
EnvironmentFile=/opt/BondRadar/.env.production
ExecStart=/bin/bash -lc '/usr/bin/python3 scripts/live_operations_runner.py --mode paper-dry-run --json-output ./logs/live_ops_paper_dry_run_$(date -u +%%Y%%m%%d).json'
