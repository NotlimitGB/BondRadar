[Unit]
Description=BondRadar confirmed virtual paper due execution
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/BondRadar
EnvironmentFile=/opt/BondRadar/.env.production
ExecStart=/bin/bash -lc '/usr/bin/python3 scripts/live_operations_runner.py --mode paper-execute --execute-due-schedules --confirm-live-operations yes --json-output ./logs/live_ops_paper_execute_$(date -u +%%Y%%m%%d).json'
