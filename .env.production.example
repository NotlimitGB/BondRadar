# App
ENVIRONMENT=production
PROJECT_NAME=BondRadar

# Database
POSTGRES_DB=bondradar
POSTGRES_USER=bondradar
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://bondradar:replace-with-a-strong-password@postgres:5432/bondradar

# Backend
API_PREFIX=/api
MOEX_ISS_BASE_URL=https://iss.moex.com
MOEX_ISS_TIMEOUT_SECONDS=20
ML_ARTIFACT_DIR=artifacts/ml

# Frontend
VITE_API_PROXY_TARGET=http://backend:8000

# CORS
# JSON-style list parsed by pydantic-settings, for example:
# BACKEND_CORS_ORIGINS=["https://bondradar.example.com"]
BACKEND_CORS_ORIGINS=[]

# Logging
# Optional operational setting. The current app does not consume LOG_LEVEL directly.
LOG_LEVEL=info

# Backups
POSTGRES_HOST=postgres
BACKUP_DIR=./backups
# Used by pg_dump/pg_restore helpers. Keep real values out of git.
PGPASSWORD=replace-with-a-strong-password
